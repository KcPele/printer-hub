{
  "name": "@printerhub/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the PrinterHub API, generated from backend/openapi.json",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../backend/openapi.json -o src/schema.d.ts --default-non-nullable false",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
