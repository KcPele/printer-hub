# Copy to .env. Every variable is optional for local development: the defaults
# in app/core/config.py match docker-compose.yml.

PRINTERHUB_ENVIRONMENT=local
PRINTERHUB_LOG_LEVEL=INFO
PRINTERHUB_LOG_JSON=false

# PostgreSQL (async driver required)
PRINTERHUB_DATABASE_URL=postgresql+asyncpg://printerhub:printerhub@localhost:5433/printerhub

# Redis
PRINTERHUB_REDIS_URL=redis://localhost:6380/0

# Secrets. Required outside local and test; startup fails if these are left at the defaults.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# PRINTERHUB_SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PRINTERHUB_CREDENTIALS_ENCRYPTION_KEY=

# Object storage (S3-compatible)
PRINTERHUB_S3_ENDPOINT_URL=http://localhost:9000
PRINTERHUB_S3_REGION=us-east-1
PRINTERHUB_S3_ACCESS_KEY=printerhub
PRINTERHUB_S3_SECRET_KEY=printerhub-dev-secret
PRINTERHUB_S3_BUCKET=printerhub-documents

# Push notifications. "log" writes pushes to the log. "fcm" sends through Firebase
# Cloud Messaging, which reaches Android directly and iOS through APNs (upload your
# APNs key in the Firebase console).
# The value is the service-account key (Firebase console > Project settings >
# Service accounts > Generate new private key), base64-encoded so it fits on one line:
#   base64 -i printerhub-firebase-adminsdk-xxxxx.json | tr -d '\n'
# This is NOT google-services.json, which is the Android app's config.
PRINTERHUB_PUSH_BACKEND=log
# PRINTERHUB_FCM_SERVICE_ACCOUNT_JSON=

# Email, for password reset and email verification codes. "log" writes emails to
# the log (codes included), which is fine on a laptop and wrong for real users.
# "smtp" works with any provider or your own mail server.
PRINTERHUB_EMAIL_BACKEND=log
# PRINTERHUB_EMAIL_FROM=PrinterHub <no-reply@example.com>
# PRINTERHUB_SMTP_HOST=smtp.example.com
# PRINTERHUB_SMTP_PORT=587
# PRINTERHUB_SMTP_USERNAME=
# PRINTERHUB_SMTP_PASSWORD=
# "starttls" for port 587, "ssl" for port 465.
# PRINTERHUB_SMTP_SECURITY=starttls

# The background worker runs inside the API process. Set to false only when
# running `arq app.worker.WorkerSettings` as a separate process.
# PRINTERHUB_EMBEDDED_WORKER=true

# Browser clients allowed to call the API (JSON list)
PRINTERHUB_CORS_ORIGINS=["http://localhost:3000"]
